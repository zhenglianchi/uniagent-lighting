# ============================================================
# uniagent-lighting 训练链环境变量参考（学习用）
# ------------------------------------------------------------
# 说明：
#   - 本文件不会被脚本自动 source，只是把散落在各脚本里的环境变量汇总成
#     一份带注释的清单，方便对照学习。
#   - 实际生效顺序：bootstrap_ray_env.sh（ray start 前）→ 训练脚本内
#     export / 默认值 → tencent_sandbox.env（凭据，脚本内 source）。
#   - 敏感值不放在这里，见 work/tencent_sandbox.env。
# ============================================================

# ---------- 1. 腾讯云沙箱凭据（来源：work/tencent_sandbox.env）----------
TENCENT_SANDBOX_TOKEN=<ark_* 主 Key：隧道/实例鉴权>
TENCENT_SANDBOX_E2B_TOKEN=<e2b_* 兼容 Key>
TENCENT_SECRET_ID=<Cloud API 控制面>
TENCENT_SECRET_KEY=<Cloud API 控制面>

# E2B 兼容端点（脚本内由 TENCENT_SANDBOX_E2B_TOKEN 派生 E2B_API_KEY）
E2B_DOMAIN=ap-guangzhou.tencentags.com
E2B_API_KEY=<同 TENCENT_SANDBOX_E2B_TOKEN>

# ---------- 2. 全局环境（训练脚本 export；ray start 前需要的必须提前注入）----------
CUDA_DEVICE_MAX_CONNECTIONS=1
VLLM_USE_V1=1                    # verl v1 引擎
RAY_memory_monitor_refresh_ms=0  # 关 Ray 内存监控（防大对象误杀）
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1             # hf-mirror 不走 Xet 协议（否则 401）
MC_STORE_MEMCPY=0                # Mooncake 禁用 GPU memcpy（与 vLLM 同卡冲突）
PATH=<conda env bin 前置；mooncake_master 等二进制需要>

# ---------- 3. Gateway 与白盒 harness（ray start 前必须 export）----------
GATEWAY_PORT=8001            # Gateway 固定端口
MSA_GATEWAY_TUNNEL=0         # 白盒：harness 在训练机本地直连，无需隧道
MSA_INSTALL_AGENT=1
MSA_REWARD_INCLUDE_P2P=1
MSA_REWARD_P2P_SAMPLE=20
TENCENT_SANDBOX_SKIP_TMUX=1

# ---------- 4. 黑盒 harness 专用（run_grpo_humanevalfix_blackbox_ucloud.sh）----------
CLAUDE_GATEWAY_TUNNEL=1            # 黑盒：默认走 SSH 隧道
MSA_GATEWAY_SSH_HOST=117.50.199.93 # 隧道目标公网 IP
# CLAUDE_GATEWAY_PUBLIC_HOST=<direct-URL 模式：安全组放行 8001 后使用>

# ---------- 5. 数据与模型 ----------
MODEL=/home/ubuntu/models/Qwen3-8B
TRAIN_FILE=/home/ubuntu/swe-rl/data/humanevalfix_train161.jsonl
VAL_FILE=/home/ubuntu/swe-rl/data/humanevalfix_val.jsonl
SERVED_MODEL_NAME=<默认取 MODEL 的 basename>
SPEC_DRAFT=/home/ubuntu/models/Qwen3-8B-speculator.eagle3  # EAGLE-3 draft 模型

# ---------- 6. 训练超参（双机正式默认值）----------
TOTAL_EPOCHS=5
TRAIN_BATCH_SIZE=32
PPO_MINI_BATCH=16
PPO_MICRO_BATCH=4
PARAM_SYNC_STEP=2   # separate_async：train_batch == pss × mini（32 == 2×16）
ROLLOUT_N=4
MAX_CKPT_KEEP=1     # 只保留最近 N 个完整 checkpoint（防磁盘累积爆盘）

# ---------- 7. Rollout / vLLM ----------
TOOL_PARSER=hermes      # gateway tool-call parser（Qwen3 官方推荐格式）
GATEWAY_COUNT=1
CONCURRENCY=64          # 并发会话数（配额只作余量，不做加速手段）
VLLM_MAX_NUM_SEQS=128   # 与 CONCURRENCY 匹配（baseline 口径）
VLLM_GPU_MEM_UTIL=0.8
SPEC_ON=1               # EAGLE-3 投机解码开关
SPEC_TOKENS=3           # 投机 token 数

# ---------- 8. 集群 / TransferQueue / Mooncake ----------
RAY_ADDRESS=10.60.216.3:6379   # Ray head 地址（node1）
MOONCAKE=1                     # 1=MooncakeStore（正式默认，与正式训练一致）；0=SimpleStorage（对照）
MOONCAKE_MASTER=10.60.216.3:50124  # mooncake master（MOONCAKE=1 时需预启动）
MOONCAKE_METADATA=10.60.216.3:50123

# ---------- 9. 输出路径 ----------
CKPT_DIR=/home/ubuntu/swe-rl/checkpoints/humanevalfix_dual_async
LOG_DIR=/home/ubuntu/swe-rl/logs/humanevalfix_dual_async

# ---------- 10. 编排链（run_dual_formal_chain.sh）与评估 ----------
NODE2=ubuntu@10.60.253.166   # 双机链从 node2 收集 actor checkpoint
# 链内覆盖：MAX_CKPT_KEEP=3、MOONCAKE=1
MODEL_PATH=/home/ubuntu/models/Qwen3-8B-final-dual-async  # 评估用最终权重
SERVED_NAME=qwen3-8b-final-dual-async                     # 评估用 served model 名
